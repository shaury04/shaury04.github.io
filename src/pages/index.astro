---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
import { withBase } from "../utils/paths";

const interests = new Intl.ListFormat("en", { style: "long", type: "conjunction" }).format(profile.interests);
---

<BaseLayout>
  <div class="shell">
    <section class="hero" aria-labelledby="intro-title">
      <div class="hero-introduction">
        <h1 id="intro-title">{profile.name}</h1>
        <p class="hero-copy">{profile.introduction}</p>
        <p class="availability">{profile.availability}</p>
        <div class="hero-actions">
          <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↘</span></a>
          <a class="text-link" href="#contact">Get in touch <span aria-hidden="true">↗</span></a>
          {profile.resume && <a class="resume-link" href={withBase(profile.resume)}>Résumé (PDF)</a>}
        </div>
      </div>
      <img class="hero-portrait" src={withBase(profile.portrait.src)} srcset={`${withBase(profile.portrait.smallSrc)} 560w, ${withBase(profile.portrait.src)} 1120w`} sizes="(max-width: 700px) 220px, (max-width: 900px) 200px, 260px" alt={profile.portrait.alt} width={profile.portrait.width} height={profile.portrait.height} fetchpriority="high" decoding="async" />
    </section>

    <section class="section" id="education" aria-labelledby="education-title">
      <h2 id="education-title">Education</h2>
      <div class="education-list">
        {profile.education.map(item => (
          <article class="education-item">
            <div class="education-logo"><img src={withBase(item.logo.src)} alt={item.logo.alt} width={item.logo.width} height={item.logo.height} loading="lazy" decoding="async" /></div>
            <div class="education-details"><h3>{item.school}</h3><p>{item.degree}</p><p class="item-meta">{item.location}</p></div>
            <p class="education-period item-meta">{item.period}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="experience" aria-labelledby="experience-title">
      <h2 id="experience-title">Experience</h2>
      <div class="experience-list">
        {profile.experience.map(item => (
          <article class="experience-item">
            <div class="experience-heading">
              <div><h3>{item.company}</h3><p class="experience-role">{item.role}</p></div>
              <div class="experience-meta item-meta"><p>{item.period}</p><p>{item.location}</p></div>
            </div>
            <ul class="experience-highlights">{item.highlights.map(highlight => <li>{highlight}</li>)}</ul>
            <p class="technologies">{item.skills.join(" · ")}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section" id="work" aria-labelledby="work-title">
      <h2 id="work-title">Projects</h2>
      <div class="project-list">
        {profile.projects.map(project => (
          <article class="project-entry">
            <div>
              <h3>{project.name}</h3>
              <p class="project-description">{project.description}</p>
              <p class="technologies">{project.technologies}</p>
            </div>
            <a class="text-link" href={project.repository} aria-label={`View ${project.name} on GitHub`}>GitHub <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
    </section>

    <section class="section personal-section" id="about" aria-labelledby="personal-title">
      <h2 id="personal-title">Outside of work</h2>
      <p class="interests">{interests}</p>
      <div class="photo-gallery" aria-label="Personal photos">
        {profile.photos.map(photo => (
          <img src={withBase(photo.src)} srcset={`${withBase(photo.smallSrc)} 560w, ${withBase(photo.src)} 1120w`} sizes="(max-width: 700px) calc((100vw - 52px) / 2), (max-width: 1080px) calc((100vw - 96px) / 3), 323px" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" />
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
