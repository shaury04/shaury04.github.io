---
import { profile } from "../data/profile";
import { withBase } from "../utils/paths";
import "../styles/global.css";

interface Props { title?: string; description?: string; noindex?: boolean; }
const {
  title = "Shaury Gautam — Software Engineering & Applied ML",
  description = "UVA Master of Computer Science student graduating in May 2027. Explore Shaury Gautam’s experience in software engineering and applied machine learning.",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(withBase("/og.png"), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fcf5e9" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shaury Gautam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Shaury Gautam — Software engineering and applied machine learning. University of Virginia, class of 2027." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href={withBase("/")} aria-label="Shaury — home">Shaury</a>
        <nav aria-label="Primary navigation">
          <a href={withBase("/#education")}>Education</a>
          <a href={withBase("/#experience")}>Experience</a>
          <a href={withBase("/#work")}>Projects</a>
          <a href={withBase("/#about")}>Outside of work</a>
          <a href={withBase("/#contact")}>Contact</a>
        </nav>
      </div>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="site-footer" id="contact" aria-labelledby="contact-title">
      <div class="shell">
        <div class="footer-grid">
          <h2 id="contact-title">Get in touch</h2>
          <div class="footer-links">
            <a href={`mailto:${profile.email}`}>{profile.email}</a>
            {profile.links.map(link => <a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a>)}
          </div>
        </div>
        <div class="footer-meta"><span>© {new Date().getFullYear()} Shaury Gautam</span><a href={withBase("/#main-content")}>Back to top <span aria-hidden="true">↑</span></a></div>
      </div>
    </footer>
  </body>
</html>
