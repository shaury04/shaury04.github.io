{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/check-build.mjs",
    "build:prefix": "BASE_PATH=/portfolio/ astro build",
    "check": "astro check",
    "check:dist": "node scripts/check-build.mjs",
    "check:prefix": "BASE_PATH=/portfolio/ node scripts/check-build.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm test && npm run build:prefix && npm run check:prefix && npm run build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.3.1"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.5.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
